# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Project Settings → Database → Connection string → URI
# Modo Session (puerto 5432) para Drizzle migraciones desde local
# Modo Transaction (puerto 6543) para Vercel serverless en producción
DATABASE_URL=postgresql://postgres.PROJECTREF:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Service role key — SOLO server-side, jamás expuesta al cliente
# Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...
